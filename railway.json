{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK"
  },
  "environments": {
    "pr": {
      "deploy": {
        "startCommand": "env PHX_HOST=$RAILWAY_PUBLIC_DOMAIN PHX_CHECK_ORIGINS=//$RAILWAY_PUBLIC_DOMAIN TFL_GEOMETRY_SOURCE=tfl sh /app/_build/prod/rel/transitmaps/bin/server"
      }
    }
  },
  "deploy": {
    "preDeployCommand": "sh /app/_build/prod/rel/transitmaps/bin/migrate",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
