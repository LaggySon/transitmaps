{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK"
  },
  "deploy": {
    "preDeployCommand": "sh /app/_build/prod/rel/transitmaps/bin/migrate",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  },
  "environments": {
    "pr": {
      "deploy": {
        "preDeployCommand": "sh /app/_build/prod/rel/transitmaps/bin/migrate && sh /app/_build/prod/rel/transitmaps/bin/bootstrap_preview",
        "startCommand": "RAILWAY_SKIP_STARTUP_REFRESH=true sh /app/_build/prod/rel/transitmaps/bin/server"
      }
    }
  }
}
